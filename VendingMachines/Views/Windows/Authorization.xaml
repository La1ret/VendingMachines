<Window x:Class="VendingMachines.View.Windows.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VendingMachines.View.Windows"
        mc:Ignorable="d"
        Title="Authorization" Height="450" Width="800">
    <Grid Background="#99ccd1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="4.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Center" Text="Вход" Grid.Column="1" Grid.Row="1"/>

        <Grid Grid.Column="1" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="User" ToolTip="Пользователь" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>

            <PasswordBox x:Name="Psw" ToolTip="Пароль" Grid.Row="1" Grid.Column="0"/> <!--Password="{Binding PswText}"-->
            <TextBox x:Name="PswText" ToolTip="Пароль" Grid.Row="1" Grid.Column="0" Text="{Binding PswText}"/>
            <ToggleButton x:Name="Toggle" Content="Скрыть" FontSize="10" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>

            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="Remember" Content="Запомнить меня" Grid.Column="0"/>
                <Button x:Name="BtnForfotPsw" Content="Забыли пароль?" Grid.Column="2"  Style="{StaticResource LinkButton}"/>
            </Grid>
            
            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Width="350">
                <Button x:Name="BtnSignIn" Content="Войти" Margin="0,15" />
                <Button x:Name="BtnSignUp" Content="Зарегистрироваться" Margin="0,15"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
